          "where": "LogAttributes['issue.fingerprint'] != '' AND $__filter(ResourceAttributes['deployment.environment.name'], $env)",
          "whereLanguage": "sql",
          "isBroadcastEnabled": true,
          "isVariableEnabled": true,
          "sourceId": "6af4960727939662854d75df"
